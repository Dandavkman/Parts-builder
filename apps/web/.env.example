# Copy to apps/web/.env.local (never commit it). Development keys only.

# Sign-in (Clerk development instance): https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where the Python geometry service runs (default shown).
GEOMETRY_SERVICE_URL=http://localhost:8000

# Development only: skip sign-in so pages can be built before Clerk is set up.
# Ignored unless NODE_ENV is development and no Clerk keys are set.
ALLOW_UNAUTHENTICATED_DEV=
