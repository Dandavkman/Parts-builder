# The same names go in Vercel (Project, Settings, Environment Variables); see docs/deploy-vercel.md.
# For local runs, copy this file to apps/web/.env.local (never commit it). Development keys only.

# Sign-in (Clerk development instance): https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Use our own sign-in pages instead of Clerk's hosted ones.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# AI (Anthropic Console). Needed from B1.8. The design agent runs in the web server.
ANTHROPIC_API_KEY=
# Model the design agent uses. Optional; defaults to claude-sonnet-5-5.
DESIGN_AGENT_MODEL=
# Set to "off" to stop the agent looking up product measurements on the web (each search costs about 1 cent). Optional; on by default.
DESIGN_AGENT_WEB_SEARCH=
# Set to "2.0" (solid bodies: vases, boxes, knobs) or "2.1" (adds blind bores and top-only round-overs) to let the agent write that Part Spec. Only after the Fly geometry service has been redeployed with it; until then leave it empty (the agent writes 1.1). Optional.
DESIGN_AGENT_SPEC_VERSION=

# Postgres (Neon free tier). Needed from B1.8b. Use the pooled connection string. Local dev can point at a Neon dev branch.
DATABASE_URL=

# File storage (Cloudflare R2 dev bucket). Needed from B1.1.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=parts-builder-dev

# Where the Python geometry service runs (default shown).
GEOMETRY_SERVICE_URL=http://localhost:8000
# Shared secret the web app sends to the geometry service (same value as the Fly secret).
# Leave empty locally and start the service with GEOMETRY_AUTH_DISABLED=1.
GEOMETRY_SERVICE_TOKEN=

# Set to 1 to enforce Free and Pro plan limits (AI messages, saved designs, STEP export). The numbers in lib/plans.ts are placeholders; leave empty until you set them. Optional.
PLANS_ENFORCED=

# Order emails (B2.9). Without both, emails are only written to the server log. Resend (resend.com) has a free tier.
RESEND_API_KEY=
# The From line, for example: Parts Builder <orders@yourdomain.com> (the domain must be verified in Resend).
EMAIL_FROM=

# Admin console (B2.7). Comma separated Clerk user ids allowed into /admin. Nobody is an admin if empty.
ADMIN_USER_IDS=

# Stripe Checkout (B2.6b). Use a TEST key (sk_test_...) from https://dashboard.stripe.com/test/apikeys. A live key is refused while prices are placeholders.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<your site>/api/stripe/webhook (event: checkout.session.completed).
STRIPE_WEBHOOK_SECRET=
# Set to 1 to charge Stripe Tax at checkout. Only after Stripe Tax is set up (O2.4). Optional.
STRIPE_TAX=

# Checkout without real money (B2.6a). Set to 1 to let orders be marked paid by the stub provider. Without it, production refuses orders (503). Never set it once real payments are on.
PAYMENTS_STUB=

# Development only: skip sign-in so pages can be built before Clerk is set up.
# Ignored unless NODE_ENV is development and no Clerk keys are set.
ALLOW_UNAUTHENTICATED_DEV=

# Error tracking. Leave empty to log to the console only. Server-side only.
SENTRY_DSN=

# Pro subscriptions (Stripe Billing). Both needed to switch it on; leave empty to keep it off.
STRIPE_PRO_PRICE_ID=
# Set to 1 only when the Pro price and limits are real; until then a live Stripe key is refused for subscriptions.
PRO_PRICE_CONFIRMED=

# Public address of the site, used in the sitemap. Optional; Vercel's production URL is used if empty.
SITE_URL=
# Seller payouts (Stripe Connect Express). Needs STRIPE_SECRET_KEY too. Leave empty to keep selling off.
STRIPE_CONNECT=
# Set to 1 only once the platform fee and payout rules are real; until then a live Stripe key is refused for Connect.
CONNECT_TERMS_CONFIRMED=
