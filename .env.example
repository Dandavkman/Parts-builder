# Copy to .env.local (never commit it). Only test and development keys belong here.
# Variable names are also what the Claude Code environment secrets use.

# --- Local services (docker compose, see infra/) ---
DATABASE_URL=postgres://parts:parts_dev_password@localhost:5432/parts_builder
TEST_DATABASE_URL=postgres://parts:parts_dev_password@localhost:5432/parts_builder_test
REDIS_URL=redis://localhost:6379

# --- AI (Anthropic Console). Needed from B1.8. ---
ANTHROPIC_API_KEY=

# --- Sign-in (Clerk, development instance). Needed from B0.4. ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- File storage (Cloudflare R2, dev bucket). Needed from B1.1. ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=parts-builder-dev

# --- Payments (Stripe, TEST mode only). Needed from Phase 2. ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Deployment. Needed when the Builder sets up deployment. ---
FLY_API_TOKEN=
